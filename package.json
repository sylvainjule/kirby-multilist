{
  "name": "kirby-multilist",
  "description": "Quickly manage lists with multiple fields in Kirby",
  "main": "index.js",
  "author": "Sylvain Julé",
  "license": "MIT",
  "scripts": {
    "dev": "kirbyup dev src/index.js",
    "build": "kirbyup src/index.js",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{css,js,vue}\""
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.1.0",
    "kirbyup": "4.0.0-beta.2",
    "prettier": "^3.5.3"
  },
  "version": "2.0.0-beta.1",
  "engines": {
    "node": ">=24"
  }
}
